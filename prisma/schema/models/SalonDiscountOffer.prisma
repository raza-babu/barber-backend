model SalonDiscountOffer {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  saloonOwnerId     String       @db.ObjectId
  name              String
  description       String?
  code              String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Float
  maxDiscountAmount Float?
  minBookingAmount  Float?       @default(0)
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean      @default(true)
  usageLimit        Int?
  usageCount        Int          @default(0)
  perUserLimit      Int?         @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relationships
  saloonOwner SaloonOwner @relation(fields: [saloonOwnerId], references: [userId])
  bookings    Booking[]

  @@index([saloonOwnerId, isActive])
  @@map("salon_discount_offers")
}
